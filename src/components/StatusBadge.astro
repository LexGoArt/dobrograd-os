---
import { t } from '../lib/data.js';
const { status, lang, size = 'sm' } = Astro.props;
const ready = status === 'ready';
const nofile = status === 'nofile';
---
<span class:list={[
  'inline-flex items-center gap-1.5 rounded-full font-semibold',
  size === 'sm' ? 'px-2.5 py-0.5 text-[11px]' : 'px-3 py-1 text-[12.5px]',
  ready ? 'bg-(--color-ok-bg) text-(--color-ok)' : nofile ? 'bg-(--color-stop-bg) text-(--color-stop)' : 'bg-(--color-warn-bg) text-(--color-warn)',
]}>
  <span class:list={['h-1.5 w-1.5 rounded-full', ready ? 'bg-(--color-ok)' : nofile ? 'bg-(--color-stop)' : 'bg-(--color-warn)']}></span>
  {ready ? t(lang, 'docs.ready') : nofile ? t(lang, 'docs2.noFile') : t(lang, 'docs.dev')}
</span>
