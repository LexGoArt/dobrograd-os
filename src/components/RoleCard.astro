---
// Картка ролі з людиною-піктограмою (обраний Alex варіант «Б»).
import Icon from './Icon.astro';
import { t } from '../lib/data.js';
const { role, lang, delay = 0 } = Astro.props;
const base = import.meta.env.BASE_URL;
const pic = `${base}img/role-${role.slug}.png`;
---
<a href={`${base}${lang}/roles/${role.slug}/`} data-reveal style={`--reveal-delay:${delay}ms`}
   class="role-card group block rounded-2xl border border-(--color-line) bg-white p-5 pt-6 text-center transition-all duration-300 hover:-translate-y-1.5 hover:border-(--color-accent) hover:shadow-xl hover:shadow-slate-200/70">
  <span class="mx-auto block h-[104px] w-[104px] overflow-hidden rounded-full bg-[radial-gradient(circle_at_50%_38%,#eef4f8_0%,var(--color-wash)_72%)]">
    <img src={pic} alt="" width="104" height="104" loading="lazy"
         class="role-pic h-full w-full object-cover object-[center_10%]" />
  </span>
  <span class="mt-3.5 block font-[family-name:var(--font-display)] text-[15px] font-bold leading-snug text-(--color-brand)">{role.cardName}</span>
  <span class="mt-1 block min-h-[34px] text-[12px] leading-snug text-(--color-mute)">{role.short}</span>
  <span class="mt-3 inline-flex items-center gap-1.5 rounded-xl border-[1.5px] border-(--color-line) px-3.5 py-1.5 text-[12.5px] font-bold text-(--color-accent) transition-all duration-200 group-hover:border-(--color-accent) group-hover:bg-(--color-accent) group-hover:text-white">
    {t(lang, 'roles.open')}
    <Icon name="arrow-right" size={12} />
  </span>
</a>

<style>
  @keyframes pic-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  .role-card:hover .role-pic { animation: pic-bob 2.4s ease-in-out infinite; }
  @media (prefers-reduced-motion: reduce) { .role-card:hover .role-pic { animation: none; } }
</style>
