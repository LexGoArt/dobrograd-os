---
import Icon from './Icon.astro';
import { t, LANGS } from '../lib/data.js';
const { lang, crumbs = [] } = Astro.props;
const base = import.meta.env.BASE_URL;
const L = (p = '') => `${base}${lang}/${p}`;
const LANG_LABELS = { uk: 'УКР', ru: 'РУС', en: 'ENG' };
// та сама сторінка іншою мовою: підміняємо мовний сегмент шляху
const switchPath = (l) => {
  const rest = Astro.url.pathname.startsWith(`${base}${lang}/`)
    ? Astro.url.pathname.slice(`${base}${lang}/`.length)
    : '';
  return `${base}${l}/${rest}`;
};
---
<header class="sticky top-0 z-30 border-b border-(--color-line) bg-white/85 backdrop-blur-xl">
  <div class="flex h-14 items-center gap-3 px-4 md:px-8">
    <button id="menu-open" type="button" class="grid h-9 w-9 place-items-center rounded-lg border border-(--color-line) lg:hidden" aria-label="Меню">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>

    <nav class="hidden min-w-0 items-center gap-1.5 text-[13px] text-(--color-mute) sm:flex" aria-label="Хлібні крихти">
      <a href={L('')} class="shrink-0 hover:text-(--color-accent)">{t(lang, 'nav.home')}</a>
      {crumbs.map((c) => (
        <>
          <span class="text-(--color-line)">/</span>
          {c.href
            ? <a href={c.href} class="shrink-0 hover:text-(--color-accent)">{c.label}</a>
            : <span class="truncate font-semibold text-(--color-brand)">{c.label}</span>}
        </>
      ))}
    </nav>

    <!-- Мобільний: пошук - лише іконка 44x44; від sm - повне поле -->
    <button id="search-open" type="button"
      class="ml-auto grid h-11 w-11 shrink-0 place-items-center rounded-xl border border-(--color-line) bg-(--color-paper) text-(--color-mute) transition-colors hover:border-(--color-accent) hover:text-(--color-accent) sm:flex sm:h-auto sm:w-72 sm:items-center sm:gap-2.5 sm:px-3.5 sm:py-2 sm:text-[13px]"
      aria-label={t(lang, 'nav.search')}>
      <Icon name="search" size={16} />
      <span class="hidden truncate sm:inline">{t(lang, 'nav.searchHint')}</span>
      <kbd class="chip ml-auto hidden rounded-md border border-(--color-line) bg-white px-1.5 py-0.5 text-[10px] text-(--color-mute) md:block">⌘K</kbd>
    </button>

    {LANGS.length > 1 && (
      <>
        <!-- Мобільний: поточна мова + dropdown -->
        <details class="relative shrink-0 sm:hidden" id="lang-dd">
          <summary class="grid h-11 w-12 cursor-pointer list-none place-items-center rounded-[10px] border border-(--color-line) bg-white text-[11px] font-extrabold text-(--color-brand) [&::-webkit-details-marker]:hidden" aria-label="Мова / Language">
            {lang.toUpperCase()}
          </summary>
          <div class="absolute right-0 top-12 z-50 min-w-[120px] overflow-hidden rounded-xl border border-(--color-line) bg-white shadow-lg">
            {LANGS.filter((l) => l !== lang).map((l) => (
              <a href={switchPath(l)} class="block min-h-[44px] px-4 py-3 text-[13px] font-bold text-(--color-ink-2) hover:bg-(--color-wash) hover:text-(--color-brand)">{LANG_LABELS[l]}</a>
            ))}
          </div>
        </details>
        <!-- Десктоп: три кнопки -->
        <div class="hidden shrink-0 rounded-[10px] border border-(--color-line) bg-white p-0.5 sm:flex" aria-label="Мова / Language">
          {LANGS.map((l) => (
            <a href={switchPath(l)}
               class:list={['grid min-h-[38px] place-items-center rounded-lg px-2 text-[10.5px] font-extrabold tracking-wide transition-colors',
                 l === lang ? 'bg-(--color-brand) text-white' : 'text-(--color-mute) hover:text-(--color-brand)']}
               aria-current={l === lang ? 'true' : undefined}>{LANG_LABELS[l]}</a>
          ))}
        </div>
      </>
    )}
  </div>
</header>

<dialog id="search-dialog" class="m-auto w-[min(92vw,640px)] rounded-2xl border border-(--color-line) p-0 shadow-2xl backdrop:bg-slate-900/40 backdrop:backdrop-blur-sm">
  <div class="p-4">
    <div id="pagefind-box"></div>
    <p class="mt-3 text-center text-[11px] text-(--color-mute)">{t(lang, 'misc.closeHint')}</p>
  </div>
</dialog>

<script is:inline define:vars={{ base }}>
  const menuBtn = document.getElementById('menu-open');
  menuBtn?.addEventListener('click', () => window.__toggleSidebar?.(true, menuBtn));
  // Закривати мовний dropdown кліком поза ним
  const dd = document.getElementById('lang-dd');
  document.addEventListener('click', (e) => { if (dd && dd.open && !dd.contains(e.target)) dd.open = false; });
  const dlg = document.getElementById('search-dialog');
  let inited = false;
  async function openSearch() {
    dlg.showModal();
    if (inited) return;
    inited = true;
    try {
      const css = document.createElement('link');
      css.rel = 'stylesheet'; css.href = `${base}pagefind/pagefind-ui.css`;
      document.head.appendChild(css);
      await import(`${base}pagefind/pagefind-ui.js`);
      new PagefindUI({ element: '#pagefind-box', showSubResults: true, showImages: false, autofocus: true });
    } catch (e) {
      document.getElementById('pagefind-box').innerHTML =
        '<p style="font-size:13px;color:#8aa0b2">Пошук доступний після збірки сайту (pagefind).</p>';
    }
  }
  document.getElementById('search-open')?.addEventListener('click', openSearch);
  window.__openSearch = openSearch;
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); openSearch(); }
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>
