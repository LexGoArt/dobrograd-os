---
import Icon from './Icon.astro';
import { t } from '../lib/data.js';
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const L = (p = '') => `${base}${lang}/${p}`;
const path = Astro.url.pathname;
const items = [
  { href: L(''), icon: 'home', label: t(lang, 'nav.home'), exact: true },
  { href: L('roles/'), icon: 'users', label: t(lang, 'nav.roles') },
  { href: L('processes/'), icon: 'route', label: t(lang, 'nav.processes') },
  { href: L('docs/'), icon: 'file-text', label: t(lang, 'nav.docs') },
  { href: L('calendar/'), icon: 'calendar', label: t(lang, 'nav.calendar') },
  { href: L('checklists/'), icon: 'check-square', label: t(lang, 'nav.checklists') },
  { href: L('kernel/'), icon: 'book', label: t(lang, 'nav.kernel') },
  { href: L('regulation/'), icon: 'sitemap', label: t(lang, 'nav.regulation') },
  { href: L('roadmap/'), icon: 'clock', label: t(lang, 'nav.roadmap') },
];
const active = (i) => i.exact ? path === i.href : path.startsWith(i.href);
---
<aside id="sidebar"
  class="fixed inset-y-0 left-0 z-50 flex w-[248px] -translate-x-full flex-col border-r border-(--color-line) bg-white transition-transform duration-200 lg:translate-x-0"
  aria-label="Навігація порталу">
  <a href={L('')} class="flex items-center gap-3 px-5 pb-5 pt-6">
    <span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-(--color-brand) text-[12px] font-extrabold text-white">ОС</span>
    <span class="leading-tight">
      <span class="block font-[family-name:var(--font-display)] text-[15px] font-bold text-(--color-brand)">{t(lang, 'site.short')}</span>
      <span class="block text-[10px] font-semibold uppercase tracking-widest text-(--color-mute)">{t(lang, 'site.org')}</span>
    </span>
  </a>

  <nav class="flex-1 space-y-0.5 overflow-y-auto px-3">
    {items.map((i) => (
      <a href={i.href}
         class:list={['flex items-center gap-3 rounded-xl px-3 py-2.5 text-[13.5px] font-medium transition-colors',
           active(i) ? 'bg-(--color-wash) font-semibold text-(--color-brand)' : 'text-(--color-ink-2) hover:bg-(--color-wash) hover:text-(--color-brand)']}
         aria-current={active(i) ? 'page' : undefined}>
        <Icon name={i.icon} size={17} class={active(i) ? 'text-(--color-accent)' : 'text-(--color-mute)'} />
        {i.label}
      </a>
    ))}
  </nav>

  <div class="m-3 rounded-2xl border border-(--color-line) bg-(--color-wash) p-4">
    <p class="text-[12.5px] font-bold text-(--color-brand)">{t(lang, 'aside.helpTitle')}</p>
    <p class="mt-1 text-[11.5px] leading-snug text-(--color-ink-2)">{t(lang, 'aside.helpText')}</p>
    <a href="https://t.me/lexgo" target="_blank" rel="noopener"
       class="mt-3 flex items-center justify-center gap-2 rounded-xl bg-(--color-accent) px-3 py-2.5 text-[12.5px] font-bold text-white transition-all hover:bg-(--color-accent-2) hover:shadow-md active:scale-[0.98]">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3c.2-.9-.7-1.6-1.5-1.3L2.7 9.9c-.9.4-.9 1.7.1 2l4.6 1.4 1.7 5.5c.3.9 1.4 1.1 2 .4l2.5-2.6 4.8 3.6c.7.5 1.7.1 1.9-.7zM17.4 7.6 9.9 14.2c-.2.2-.3.4-.3.6l-.3 2.6-1.3-4.3c-.1-.4 0-.8.4-1l8.6-5.1c.4-.2.7.3.4.6z"/></svg>
      {t(lang, 'aside.tgButton')}
    </a>
  </div>
  <p class="px-5 pb-4 text-[10.5px] text-(--color-mute)">© {new Date().getFullYear()} {t(lang, 'site.org')}</p>
</aside>

<div id="sidebar-scrim" class="fixed inset-0 z-40 hidden bg-slate-900/40 backdrop-blur-sm lg:hidden"></div>

<script>
  const sb = document.getElementById('sidebar');
  const scrim = document.getElementById('sidebar-scrim');
  function toggle(open?: boolean) {
    const show = open ?? sb!.classList.contains('-translate-x-full');
    sb!.classList.toggle('-translate-x-full', !show);
    scrim!.classList.toggle('hidden', !show);
  }
  (window as any).__toggleSidebar = toggle;
  scrim?.addEventListener('click', () => toggle(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') toggle(false); });
</script>
