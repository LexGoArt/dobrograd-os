---
import Icon from './Icon.astro';
import { t } from '../lib/data.js';
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const L = (p = '') => `${base}${lang}/${p}`;
const path = Astro.url.pathname;

const GROUPS = [
  { label: t(lang, 'nav.groupWork'), items: [
    { href: L(''), icon: 'home', label: t(lang, 'nav.home'), exact: true },
    { href: L('roles/'), icon: 'users', label: t(lang, 'nav.roles') },
    { href: L('processes/'), icon: 'route', label: t(lang, 'nav.processes') },
    { href: L('calendar/'), icon: 'calendar', label: t(lang, 'nav.calendar') },
    { href: L('checklists/'), icon: 'check-square', label: t(lang, 'nav.checklists') },
  ]},
  { label: t(lang, 'nav.groupBase'), items: [
    { href: L('docs/'), icon: 'file-text', label: t(lang, 'nav.docs') },
    { href: L('kernel/'), icon: 'book', label: t(lang, 'nav.kernel') },
    { href: L('regulation/'), icon: 'sitemap', label: t(lang, 'nav.regulation') },
    { href: L('roadmap/'), icon: 'clock', label: t(lang, 'nav.roadmap') },
  ]},
];
const active = (i) => i.exact ? path === i.href : path.startsWith(i.href);
---
<aside id="sidebar"
  class="fixed inset-y-0 left-0 z-50 flex w-[248px] -translate-x-full flex-col border-r border-(--color-line) bg-white transition-[transform,width] duration-200 lg:translate-x-0"
  aria-label="Навігація порталу">
  <div class="flex items-start justify-between px-5 pb-4 pt-6">
    <a href={L('')} class="block min-w-0">
      <img src={`${base}img/dobrograd-logo.svg`} alt="Доброград" width="835" height="196" class="h-9 w-auto nav-extra" />
      <img src={`${base}img/dobrograd-mark.svg`} alt="Доброград" width="216" height="196" class="hidden h-9 w-auto html-nav-mark" />
      <span class="nav-extra mt-2.5 block text-[10.5px] font-bold uppercase tracking-[0.14em] text-(--color-mute)">{t(lang, 'site.short')} · Iron Invest</span>
    </a>
    <button id="sidebar-close" type="button"
      class="grid h-11 w-11 shrink-0 place-items-center rounded-[10px] border border-(--color-line) text-(--color-ink-2) hover:border-(--color-accent) hover:text-(--color-accent) lg:hidden"
      aria-label={t(lang, 'misc.close')}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m6 6 12 12M18 6 6 18"/></svg>
    </button>
  </div>

  <nav class="flex-1 space-y-5 overflow-y-auto px-3 pb-2">
    {GROUPS.map((g) => (
      <div>
        <p class="nav-extra mb-1.5 px-3 text-[10.5px] font-bold uppercase tracking-[0.14em] text-(--color-mute)">{g.label}</p>
        <div class="space-y-0.5">
          {g.items.map((i) => (
            <a href={i.href} title={i.label}
               class:list={['relative flex min-h-[44px] items-center gap-3 rounded-[10px] px-3 text-[13.5px] font-medium transition-colors',
                 active(i) ? 'bg-(--color-wash) font-semibold text-(--color-brand)' : 'text-(--color-ink-2) hover:bg-(--color-wash) hover:text-(--color-brand)']}
               aria-current={active(i) ? 'page' : undefined}>
              {active(i) && <span class="absolute left-0 top-1/2 h-5 w-1 -translate-y-1/2 rounded-full bg-(--color-accent)" aria-hidden="true"></span>}
              <Icon name={i.icon} size={17} class={active(i) ? 'shrink-0 text-(--color-accent)' : 'shrink-0 text-(--color-mute)'} />
              <span class="nav-label">{i.label}</span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </nav>

  <div class="nav-extra m-3 rounded-2xl border border-(--color-line) bg-(--color-wash) p-4">
    <p class="text-[12.5px] font-bold text-(--color-brand)">{t(lang, 'aside.helpTitle')}</p>
    <p class="mt-1 text-[12px] leading-snug text-(--color-ink-2)">{t(lang, 'aside.helpText')}</p>
    <a href="https://t.me/lexgo" target="_blank" rel="noopener"
       class="mt-3 flex min-h-[44px] items-center justify-center gap-2 rounded-[10px] bg-(--color-accent) px-3 text-[12.5px] font-bold text-white transition-all hover:bg-(--color-accent-2) active:scale-[0.98]">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3c.2-.9-.7-1.6-1.5-1.3L2.7 9.9c-.9.4-.9 1.7.1 2l4.6 1.4 1.7 5.5c.3.9 1.4 1.1 2 .4l2.5-2.6 4.8 3.6c.7.5 1.7.1 1.9-.7zM17.4 7.6 9.9 14.2c-.2.2-.3.4-.3.6l-.3 2.6-1.3-4.3c-.1-.4 0-.8.4-1l8.6-5.1c.4-.2.7.3.4.6z"/></svg>
      {t(lang, 'aside.tgButton')}
    </a>
    <a href={L('help/')} class="mt-2 block text-center text-[11.5px] font-semibold text-(--color-mute) hover:text-(--color-accent)">{t(lang, 'home.howLink')}</a>
  </div>

  <button id="sidebar-collapse" type="button"
    class="mx-3 mb-4 hidden min-h-[40px] items-center justify-center gap-2 rounded-[10px] border border-(--color-line) text-[12px] font-semibold text-(--color-mute) transition-colors hover:border-(--color-accent) hover:text-(--color-accent) lg:flex"
    aria-label={t(lang, 'misc.collapse')} aria-expanded="true">
    <svg class="collapse-arrow transition-transform duration-200" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m14 6-6 6 6 6"/></svg>
    <span class="nav-label">{t(lang, 'misc.collapse')}</span>
  </button>
</aside>

<div id="sidebar-scrim" class="fixed inset-0 z-40 hidden bg-slate-900/45 backdrop-blur-sm lg:hidden"></div>

<style>
  :global(html.nav-min) .html-nav-mark { display: block; }
</style>

<script>
  const sb = document.getElementById('sidebar')!;
  const scrim = document.getElementById('sidebar-scrim')!;
  const closeBtn = document.getElementById('sidebar-close')!;
  let opener: HTMLElement | null = null;

  function focusables() {
    return [...sb.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')]
      .filter((el) => el.offsetParent !== null);
  }
  function toggle(open?: boolean, trigger?: HTMLElement) {
    const show = open ?? sb.classList.contains('-translate-x-full');
    sb.classList.toggle('-translate-x-full', !show);
    scrim.classList.toggle('hidden', !show);
    if (show) {
      opener = trigger ?? (document.activeElement as HTMLElement);
      focusables()[0]?.focus();
    } else {
      opener?.focus();
      opener = null;
    }
  }
  (window as any).__toggleSidebar = toggle;
  scrim.addEventListener('click', () => toggle(false));
  closeBtn.addEventListener('click', () => toggle(false));
  document.addEventListener('keydown', (e) => {
    const mobileOpen = !sb.classList.contains('-translate-x-full') && window.innerWidth < 1024;
    if (e.key === 'Escape' && mobileOpen) toggle(false);
    if (e.key === 'Tab' && mobileOpen) {
      // focus trap усередині мобільного меню
      const f = focusables();
      if (!f.length) return;
      const first = f[0], last = f[f.length - 1];
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  // Згортання сайдбара на десктопі (запамʼятовується)
  const collapseBtn = document.getElementById('sidebar-collapse')!;
  const applyMin = (min: boolean) => {
    document.documentElement.classList.toggle('nav-min', min);
    collapseBtn.setAttribute('aria-expanded', String(!min));
    collapseBtn.querySelector('.collapse-arrow')!.setAttribute('style', min ? 'transform: rotate(180deg)' : '');
  };
  applyMin(localStorage.getItem('nav-min') === '1');
  collapseBtn.addEventListener('click', () => {
    const min = !document.documentElement.classList.contains('nav-min');
    localStorage.setItem('nav-min', min ? '1' : '0');
    applyMin(min);
  });
</script>
