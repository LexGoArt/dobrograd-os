---
// Місячний цикл: дані кроків - у словнику мови (i18n cycle.steps).
import { t } from '../lib/data.js';
const { lang } = Astro.props;
const base = import.meta.env.BASE_URL;
const D = (slug) => `${base}${lang}/docs/${slug}/`;
const STEPS = t(lang, 'cycle.steps');
---
<div class="cycle-scroll relative">
  <div class="overflow-x-auto pb-2 snap-x snap-mandatory lg:snap-none">
    <ol class="flex min-w-[720px] gap-0 lg:min-w-0">
    {STEPS.map((s, i) => (
      <li class="relative flex-1">
        <div class="flex items-center">
          <span class:list={[
            'chip z-10 grid h-10 shrink-0 place-items-center rounded-full px-3 text-[12px] font-bold',
            s.accent ? 'bg-(--color-ok) text-white' : 'bg-(--color-brand) text-white',
          ]}>{s.day}</span>
          {i < STEPS.length - 1 && <span class="h-0.5 flex-1 bg-(--color-line)"></span>}
        </div>
        <div class="mt-3 pr-4">
          <p class="text-[14px] font-bold text-(--color-brand)">{s.title}</p>
          <p class="mt-1 text-[12.5px] leading-snug text-(--color-ink-2)">{s.text}</p>
          {s.links.length > 0 && (
            <p class="mt-1.5 flex flex-wrap gap-1.5">
              {s.links.map(([idx, slug]) => (
                <a href={D(slug)} class="chip rounded-md bg-(--color-wash) px-1.5 py-0.5 text-[11px] text-(--color-accent) hover:bg-(--color-accent) hover:text-white transition-colors">{idx}</a>
              ))}
            </p>
          )}
        </div>
      </li>
    ))}
    </ol>
  </div>
  <span class="cycle-fade" aria-hidden="true"></span>
  <p class="mt-1 text-[12px] font-semibold text-(--color-accent) lg:hidden">{t(lang, 'cycle.swipeHint')} →</p>
</div>

<style>
  .cycle-scroll li { scroll-snap-align: start; }
  .cycle-fade {
    pointer-events: none; position: absolute; top: 0; bottom: 14px; right: 0; width: 56px;
    background: linear-gradient(to right, transparent, #fff);
  }
  @media (min-width: 1024px) { .cycle-fade { display: none; } }
</style>
