---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import Topbar from '../components/Topbar.astro';
import Footer from '../components/Footer.astro';

const { lang = 'uk', title, description = '', crumbs = [], plain = false } = Astro.props;

// Share-метадані (OG) - англійською для всіх сторінок: прев'ю посилань у месенджерах і соцмережах
const SITE_URL = 'https://lexgoart.github.io/dobrograd-os/';
const OG_TITLE = 'Construction Block Operating System - Dobrograd · Iron Invest';
const OG_DESC = '34 regulations · 14 roles · payment paths · checklists · the monthly rhythm. One internal knowledge base for the construction block (uk / ru / en).';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Construction Block OS" />
    <meta property="og:title" content={OG_TITLE} />
    <meta property="og:description" content={OG_DESC} />
    <meta property="og:image" content={`${SITE_URL}img/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={OG_TITLE} />
    <meta name="twitter:description" content={OG_DESC} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lexend:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}img/dobrograd-mark.svg`} />
  </head>
  <body class="min-h-dvh bg-(--color-paper) font-[family-name:var(--font-sans)]">
    <Sidebar lang={lang} />
    <div class="flex min-h-dvh flex-col lg:pl-[248px]">
      <Topbar lang={lang} crumbs={crumbs} />
      <main class="flex-1">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <script>
      // Scroll-reveal: секції з data-reveal мʼяко зʼявляються
      const items = document.querySelectorAll('[data-reveal]');
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('in-view'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in-view'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
        items.forEach((el) => io.observe(el));
        // страховка: якщо спостерігач не спрацював (фонова вкладка, старий браузер) - показати все
        setTimeout(() => items.forEach((el) => el.classList.add('in-view')), 2000);
      }
    </script>
  </body>
</html>
