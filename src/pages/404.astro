---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base lang="uk" title="Сторінку не знайдено">
  <div class="mx-auto max-w-3xl px-4 py-24 text-center">
    <p class="chip text-6xl font-extrabold text-(--color-line)">404</p>
    <h1 class="mt-4 text-xl font-bold text-(--color-brand)">Сторінку не знайдено</h1>
    <p class="mt-2 text-[14px] text-(--color-ink-2)">Можливо, документ ще в розробці або адресу змінено.</p>
    <a href={`${base}uk/`} class="mt-6 inline-block rounded-xl bg-(--color-accent) px-5 py-3 text-[14px] font-bold text-white hover:bg-(--color-accent-2)">На головну</a>
  </div>
</Base>
