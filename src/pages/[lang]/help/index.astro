---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import { LANGS, getData, t } from '../../../lib/data.js';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const base = import.meta.env.BASE_URL;
const L = (p) => `${base}${lang}/${p}`;
const how = t(lang, 'home.how');
const glossary = t(lang, 'help.glossary');
---
<Base lang={lang} title={`${t(lang, 'help.title')} - ${t(lang, 'site.short')}`} crumbs={[{ label: t(lang, 'help.title') }]}>
  <div class="mx-auto max-w-4xl px-4 py-10 md:px-8" data-pagefind-body>
    <h1 class="text-2xl font-extrabold text-(--color-brand) md:text-3xl">{t(lang, 'help.title')}</h1>
    <p class="mt-3 max-w-2xl text-[15px] leading-relaxed text-(--color-ink-2)">{t(lang, 'help.lead')}</p>

    <!-- Як користуватися -->
    <section class="mt-8">
      <h2 class="text-[18px] font-extrabold text-(--color-brand)">{t(lang, 'home.howTitle')}</h2>
      <div class="mt-4 space-y-3">
        {how.map((h, i) => (
          <div class="flex items-start gap-4 rounded-2xl border border-(--color-line) bg-white p-5" data-reveal style={`--reveal-delay:${i * 70}ms`}>
            <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-(--color-accent) text-[14px] font-extrabold text-white">{i + 1}</span>
            <div>
              <p class="text-[15px] font-bold text-(--color-brand)">{h.title}</p>
              <p class="mt-1 text-[14px] leading-relaxed text-(--color-ink-2)">{h.text}</p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Глосарій -->
    <section class="mt-10">
      <h2 class="text-[18px] font-extrabold text-(--color-brand)">{t(lang, 'help.glossaryTitle')}</h2>
      <div class="mt-4 overflow-hidden rounded-2xl border border-(--color-line) bg-white">
        {glossary.map(([abbr, text]) => (
          <div class="flex items-start gap-4 border-b border-(--color-line) px-5 py-3.5 last:border-b-0">
            <span class="chip mt-0.5 inline-grid min-w-[64px] shrink-0 place-items-center rounded-lg bg-(--color-wash) px-2 py-1 text-[12.5px] font-bold text-(--color-brand)">{abbr}</span>
            <p class="text-[14px] leading-relaxed text-(--color-ink-2)">{text}</p>
          </div>
        ))}
      </div>
      <p class="mt-4 flex items-start gap-2.5 rounded-xl bg-(--color-wash) px-4 py-3.5 text-[13.5px] leading-relaxed text-(--color-ink-2)">
        <Icon name="question" size={16} class="mt-0.5 shrink-0 text-(--color-accent)" />
        {t(lang, 'help.indexHint')}
      </p>
    </section>

    <!-- Куди звертатися -->
    <section class="mt-10 rounded-[20px] border border-(--color-line) bg-white p-6">
      <p class="text-[15px] font-bold text-(--color-brand)">{t(lang, 'aside.helpTitle')}</p>
      <p class="mt-1 text-[14px] text-(--color-ink-2)">{t(lang, 'aside.helpText')}</p>
      <a href="https://t.me/lexgo" target="_blank" rel="noopener"
         class="mt-4 inline-flex min-h-[48px] items-center gap-2 rounded-[10px] bg-(--color-accent) px-6 text-[14px] font-bold text-white transition-all hover:bg-(--color-accent-2) active:scale-[0.98]">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.9 4.3c.2-.9-.7-1.6-1.5-1.3L2.7 9.9c-.9.4-.9 1.7.1 2l4.6 1.4 1.7 5.5c.3.9 1.4 1.1 2 .4l2.5-2.6 4.8 3.6c.7.5 1.7.1 1.9-.7zM17.4 7.6 9.9 14.2c-.2.2-.3.4-.3.6l-.3 2.6-1.3-4.3c-.1-.4 0-.8.4-1l8.6-5.1c.4-.2.7.3.4.6z"/></svg>
        {t(lang, 'aside.tgButton')}
      </a>
    </section>
  </div>
</Base>
