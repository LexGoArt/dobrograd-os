---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CycleBoard from '../../components/CycleBoard.astro';
import RoleCardWide from '../../components/RoleCardWide.astro';
import { LANGS, getData, t } from '../../lib/data.js';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const base = import.meta.env.BASE_URL;
const { roles } = getData(lang);
const L = (p = '') => `${base}${lang}/${p}`;
const A = (href) => href === 'tg' ? 'https://t.me/lexgo' : L(href);

const PRIMARY = ['nachalnyk-dilnytsi', 'prorab', 'vtv', 'kp'];
const primaryRoles = PRIMARY.map((s) => roles.find((r) => r.slug === s)).filter(Boolean);
const start = t(lang, 'home.start');
const quickQueries = t(lang, 'home.quickQueries');
const actions = t(lang, 'home.actions');
// різна візуальна вага стартових карток
const startStyles = [
  'bg-(--color-brand) text-white border-transparent',
  'bg-white border-(--color-line)',
  'bg-(--color-wash) border-(--color-line)',
];
---
<Base lang={lang} title={t(lang, 'site.name')} description={t(lang, 'site.tagline')}>
  <!-- Перший екран: заголовок + великий пошук -->
  <section class="relative overflow-hidden border-b border-(--color-line) bg-white">
    <img src={`${base}img/hero-blueprint.png`} alt="" width="2688" height="1536" fetchpriority="high"
         class="pointer-events-none absolute -right-16 -top-6 hidden w-[720px] opacity-[0.18] lg:block" />
    <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-white via-white/75 to-transparent lg:block"></div>
    <div class="relative mx-auto max-w-6xl px-4 pb-10 pt-10 md:px-8 md:pb-12 md:pt-14">
      <h1 class="max-w-2xl text-[28px] font-extrabold leading-tight text-(--color-brand) md:text-[2.4rem] md:leading-[1.15]">
        {t(lang, 'home.heroTitle')}
      </h1>
      <p class="mt-3 max-w-xl text-[15px] leading-relaxed text-(--color-ink-2)">{t(lang, 'home.heroLead')}</p>

      <!-- Великий пошук -->
      <button id="hero-search" type="button"
        class="mt-6 flex min-h-[56px] w-full max-w-2xl items-center gap-3.5 rounded-2xl border-2 border-(--color-line) bg-(--color-paper) px-5 text-left text-[15px] text-(--color-mute) shadow-sm transition-all hover:border-(--color-accent) hover:shadow-md">
        <Icon name="search" size={19} class="shrink-0 text-(--color-accent)" />
        <span class="truncate">{t(lang, 'home.searchTitle')}</span>
        <kbd class="chip ml-auto hidden rounded-md border border-(--color-line) bg-white px-2 py-1 text-[11px] text-(--color-mute) md:block">⌘K</kbd>
      </button>
      <div class="mt-3.5 flex max-w-2xl flex-wrap gap-2">
        {quickQueries.map((q) => (
          <a href={L(q.href)} class="inline-flex min-h-[38px] items-center rounded-full border border-(--color-line) bg-white px-4 text-[13px] font-semibold text-(--color-ink-2) transition-colors hover:border-(--color-accent) hover:text-(--color-accent)">
            {q.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- З чого почнемо? -->
  <section class="mx-auto max-w-6xl px-4 pt-10 md:px-8 md:pt-12">
    <h2 class="text-[21px] font-extrabold text-(--color-brand)" data-reveal>{t(lang, 'home.startTitle')}</h2>
    <div class="mt-4 grid grid-cols-1 gap-3.5 md:grid-cols-3">
      {start.map((c, i) => (
        <a href={L(c.href)} data-reveal style={`--reveal-delay:${i * 80}ms`}
           class:list={['group relative rounded-[20px] border p-6 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md', startStyles[i]]}>
          <span class:list={['grid h-11 w-11 place-items-center rounded-xl',
            i === 0 ? 'bg-white/15 text-white' : 'bg-white text-(--color-accent) shadow-sm']}>
            <Icon name={c.icon} size={21} />
          </span>
          <span class:list={['mt-4 block font-[family-name:var(--font-display)] text-[16.5px] font-bold leading-snug', i === 0 ? 'text-white' : 'text-(--color-brand)']}>{c.title}</span>
          <span class:list={['mt-1 block text-[13.5px] leading-relaxed', i === 0 ? 'text-white/75' : 'text-(--color-ink-2)']}>{c.text}</span>
          <span class:list={['mt-3 inline-flex items-center gap-1.5 text-[13px] font-bold', i === 0 ? 'text-white' : 'text-(--color-accent)']}>
            {c.cta} <Icon name="arrow-right" size={13} class="transition-transform group-hover:translate-x-0.5" />
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Робота за ролями -->
  <section class="mx-auto max-w-6xl px-4 pt-10 md:px-8 md:pt-12">
    <div class="flex flex-wrap items-end justify-between gap-2" data-reveal>
      <div>
        <h2 class="text-[21px] font-extrabold text-(--color-brand)">{t(lang, 'home.rolesTitle')}</h2>
        <p class="mt-1 text-[13.5px] text-(--color-mute)">{t(lang, 'home.rolesHint')}</p>
      </div>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-3.5 lg:grid-cols-2">
      {primaryRoles.map((r, i) => <RoleCardWide role={r} lang={lang} delay={i * 70} />)}
    </div>
    <a href={L('roles/')} data-reveal
       class="mt-4 flex min-h-[52px] items-center justify-center gap-2 rounded-2xl border-2 border-(--color-accent) bg-white px-5 text-[14.5px] font-bold text-(--color-accent) transition-all hover:bg-(--color-accent) hover:text-white">
      {t(lang, 'home.allRolesBtn')} <Icon name="arrow-right" size={15} />
    </a>
  </section>

  <!-- Актуально зараз: інтерактивний місячний цикл -->
  <section class="mx-auto max-w-6xl px-4 pt-10 md:px-8 md:pt-12">
    <div class="rounded-[20px] border border-(--color-line) bg-white p-5 md:p-7" data-reveal>
      <div class="mb-5 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-[21px] font-extrabold text-(--color-brand)">{t(lang, 'home.nowTitle')}</h2>
        <a href={L('processes/monthly-cycle/')} class="inline-flex min-h-[40px] items-center gap-1.5 text-[13.5px] font-semibold text-(--color-accent) hover:text-(--color-accent-2)">
          {t(lang, 'home.nowOpen')} <Icon name="arrow-right" size={14} />
        </a>
      </div>
      <CycleBoard lang={lang} />
    </div>
  </section>

  <!-- Швидкі дії -->
  <section class="mx-auto max-w-6xl px-4 pt-10 md:px-8 md:pt-12">
    <h2 class="text-[21px] font-extrabold text-(--color-brand)" data-reveal>{t(lang, 'home.actionsTitle')}</h2>
    <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2 xl:grid-cols-3">
      {actions.map((a, i) => (
        <a href={A(a.href)} target={a.href === 'tg' ? '_blank' : undefined} rel={a.href === 'tg' ? 'noopener' : undefined}
           data-reveal style={`--reveal-delay:${i * 50}ms`}
           class="group flex min-h-[76px] items-center gap-4 rounded-2xl border border-(--color-line) bg-white p-4 transition-all duration-200 hover:border-(--color-accent) hover:shadow-sm">
          <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-(--color-wash) text-(--color-accent) transition-colors group-hover:bg-(--color-accent) group-hover:text-white">
            <Icon name={a.icon} size={19} />
          </span>
          <span class="min-w-0">
            <span class="block text-[14px] font-bold leading-snug text-(--color-brand)">{a.title}</span>
            <span class="mt-0.5 block text-[12.5px] leading-snug text-(--color-mute)">{a.text}</span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Компактне посилання на довідку -->
  <section class="mx-auto max-w-6xl px-4 py-10 md:px-8 md:py-12">
    <a href={L('help/')} data-reveal
       class="flex min-h-[56px] flex-wrap items-center gap-3 rounded-2xl border border-(--color-line) bg-(--color-wash) px-5 py-3 transition-colors hover:border-(--color-accent)">
      <Icon name="question" size={17} class="shrink-0 text-(--color-accent)" />
      <span class="text-[14px] font-bold text-(--color-brand)">{t(lang, 'home.howLink')}</span>
      <Icon name="arrow-right" size={14} class="ml-auto shrink-0 text-(--color-accent)" />
    </a>
  </section>
</Base>

<script>
  document.getElementById('hero-search')?.addEventListener('click', () => (window as any).__openSearch?.());
</script>
