---
import Base from '../../../layouts/Base.astro';
import Blocks from '../../../components/Blocks.astro';
import Icon from '../../../components/Icon.astro';
import { LANGS, getData, t } from '../../../lib/data.js';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getData(lang).kernel.chapters.map((ch) => ({ params: { lang, num: ch.num }, props: { ch } }))
  );
}
const { lang } = Astro.params;
const { ch } = Astro.props;
const base = import.meta.env.BASE_URL;
const { kernel } = getData(lang);
const L = (p) => `${base}${lang}/${p}`;
const i = kernel.chapters.findIndex((c) => c.num === ch.num);
const prev = kernel.chapters[i - 1], next = kernel.chapters[i + 1];
const anchor = (s) => s.toLowerCase().replace(/[^a-zа-яіїєґ0-9]+/gi, '-').replace(/^-|-$/g, '');

// розбиваємо главу на секції ЛИШЕ по головних розділах (прапорець major
// ставиться на етапі збірки даних і переживає переклади);
// підзаголовки (ролі, підпункти) лишаються всередині картки
const sections = [];
let cur = { title: null, id: null, blocks: [] };
for (const b of ch.blocks) {
  if (b.t === 'h' && b.major) {
    if (cur.blocks.length || cur.title) sections.push(cur);
    cur = { title: b.text, id: anchor(b.text), blocks: [] };
  } else cur.blocks.push(b);
}
if (cur.blocks.length || cur.title) sections.push(cur);
---
<Base lang={lang} title={`${ch.num}. ${ch.title} - ${t(lang, 'kernel.title')}`} crumbs={[{ label: t(lang, 'nav.kernel'), href: L('kernel/') }, { label: `${ch.num}. ${ch.title}` }]}>
  <div id="read-progress" aria-hidden="true"></div>
  <div class="mx-auto max-w-6xl gap-10 px-4 py-10 md:px-8 lg:flex">
    <aside class="no-print mb-8 shrink-0 lg:sticky lg:top-20 lg:mb-0 lg:h-fit lg:max-h-[calc(100dvh-6rem)] lg:w-64 lg:overflow-y-auto">
      <a href={L('kernel/')} class="text-[13px] font-semibold text-(--color-mute) hover:text-(--color-accent)">← {t(lang, 'kernel.title')}</a>
      <nav class="mt-4 space-y-1" aria-label={t(lang, 'kernel.chapters')}>
        {kernel.chapters.map((c) => (
          <a href={L(`kernel/${c.num}/`)}
             class:list={['block rounded-lg px-3 py-2 text-[13px] font-medium leading-snug transition-colors',
               c.num === ch.num ? 'bg-(--color-wash) text-(--color-brand) font-bold' : 'text-(--color-ink-2) hover:bg-(--color-wash)']}>
            {c.num}. {c.title}
          </a>
        ))}
      </nav>
      {sections.filter((s) => s.title).length > 1 && (
        <div class="mt-6 hidden border-t border-(--color-line) pt-4 lg:block">
          <p class="mb-2 px-3 text-[11px] font-bold uppercase tracking-wider text-(--color-mute)">{t(lang, 'misc.onThisPage')}</p>
          <nav id="toc" class="space-y-0.5 border-l-2 border-(--color-line)">
            {sections.filter((s) => s.title).map((s) => (
              <a href={`#${s.id}`} data-toc={s.id}
                 class="-ml-0.5 block border-l-2 border-transparent px-3 py-1.5 text-[12px] leading-snug text-(--color-ink-2) transition-colors hover:text-(--color-accent)">{s.title}</a>
            ))}
          </nav>
        </div>
      )}
    </aside>

    <article class="min-w-0 flex-1" data-pagefind-body>
      <p class="text-[12px] font-bold uppercase tracking-widest text-(--color-mute)">{t(lang, 'kernel.chapter')} {ch.num} / {kernel.chapters.length}</p>
      <h1 class="mt-1 text-[32px] leading-[1.1] font-extrabold text-(--color-brand) md:text-[44px] md:leading-[1.07]">{ch.title}</h1>

      <div class="mt-7 space-y-5">
        {sections.map((s) => (
          <section id={s.id} class="scroll-mt-24 rounded-2xl border border-(--color-line) bg-white p-5 md:p-6" data-reveal data-spy={s.id}>
            {s.title && <h2 class="mb-4 flex items-center gap-2.5 border-b border-(--color-line) pb-3 text-[15px] font-extrabold text-(--color-brand)">
              <span class="h-4 w-1 rounded-full bg-(--color-accent)"></span>{s.title}
            </h2>}
            <Blocks blocks={s.blocks} lang={lang} />
          </section>
        ))}
      </div>

      <div class="no-print mt-10 flex items-stretch justify-between gap-3">
        {prev ? (
          <a href={L(`kernel/${prev.num}/`)} class="group flex flex-1 items-center gap-3 rounded-2xl border border-(--color-line) bg-white p-4 transition-all hover:border-(--color-accent) hover:shadow-sm">
            <Icon name="arrow-right" size={15} class="rotate-180 text-(--color-mute) group-hover:text-(--color-accent)" />
            <span class="min-w-0"><span class="block text-[10.5px] font-bold uppercase tracking-wider text-(--color-mute)">{t(lang, 'kernel.prev')}</span>
            <span class="block truncate text-[13px] font-bold text-(--color-brand)">{prev.num}. {prev.title}</span></span>
          </a>
        ) : <span class="flex-1" />}
        {next ? (
          <a href={L(`kernel/${next.num}/`)} class="group flex flex-1 items-center justify-end gap-3 rounded-2xl border border-(--color-line) bg-white p-4 text-right transition-all hover:border-(--color-accent) hover:shadow-sm">
            <span class="min-w-0"><span class="block text-[10.5px] font-bold uppercase tracking-wider text-(--color-mute)">{t(lang, 'kernel.next')}</span>
            <span class="block truncate text-[13px] font-bold text-(--color-brand)">{next.num}. {next.title}</span></span>
            <Icon name="arrow-right" size={15} class="text-(--color-mute) group-hover:text-(--color-accent)" />
          </a>
        ) : <span class="flex-1" />}
      </div>
    </article>
  </div>
</Base>

<script>
  // Прогрес читання
  const bar = document.getElementById('read-progress');
  const onScroll = () => {
    const h = document.documentElement;
    const p = h.scrollTop / (h.scrollHeight - h.clientHeight);
    bar!.style.width = `${Math.min(100, p * 100)}%`;
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scrollspy: активний пункт «маячка» у змісті
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')];
  const spies = [...document.querySelectorAll<HTMLElement>('[data-spy]')];
  if (links.length && spies.length) {
    const setActive = (id: string) => links.forEach((l) => {
      const on = l.dataset.toc === id;
      l.classList.toggle('font-bold', on);
      l.style.color = on ? 'var(--color-accent)' : '';
      l.style.borderLeftColor = on ? 'var(--color-accent)' : '';
    });
    const io = new IntersectionObserver((entries) => {
      const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
      if (vis[0]) setActive((vis[0].target as HTMLElement).dataset.spy!);
    }, { rootMargin: '-20% 0px -65% 0px' });
    spies.forEach((s) => io.observe(s));
  }
</script>
