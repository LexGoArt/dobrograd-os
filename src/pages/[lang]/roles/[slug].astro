---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import DocChip from '../../../components/DocChip.astro';
import { autolink } from '../../../lib/autolink.js';
import { LANGS, getData, t } from '../../../lib/data.js';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getData(lang).roles.map((role) => ({ params: { lang, slug: role.slug }, props: { role } }))
  );
}
const { lang } = Astro.params;
const { role } = Astro.props;
const base = import.meta.env.BASE_URL;
const { docs, dict } = getData(lang);
const L = (p) => `${base}${lang}/${p}`;
const opts = { base, lang, dict: dict.indexes, terms: dict.terms };
const A = (s) => autolink(s, opts);
const clean = (s) => s.replace(/^\d+\s*\|\s*/, '').replace(/^•\s*\|?\s*/, '');

const byIdx = (idx) => docs.find((d) => d.index === idx);
const submitDocs = role.submits.map(byIdx).filter(Boolean);
const receiveDocs = role.receives.map(byIdx).filter(Boolean);
const mainDocs = [...submitDocs, ...receiveDocs].slice(0, 8);
const zone = role.sections.find((s) => s.title === 'Зона відповідальності')?.items ?? [];
const duties = role.sections.find((s) => s.title === 'Обовʼязки')?.items ?? [];
const { roles } = getData(lang);
const bossRole = role.boss ? roles.find((r) => r.slug === role.boss) : null;
const nearestTerms = submitDocs.slice(0, 2).map((d) => `${d.index} - ${d.term}`);
const dodatkyFolder = 'https://drive.google.com/drive/folders/138djReP4BtAYFvFxLdX8EE8ew1h6vlj2';
// якірна навігація по секціях сторінки
const anchors = [
  { id: 'tasks', label: t(lang, 'roles.keyTasks') },
  ...(duties.length ? [{ id: 'duties', label: t(lang, 'roles.duties') }] : []),
  { id: 'docs', label: t(lang, 'roles.mainDocs') },
  ...(role.chain.length ? [{ id: 'chain', label: t(lang, 'roles.chain') }] : []),
  ...(role.asked.length ? [{ id: 'asked', label: t(lang, 'roles.asked') }] : []),
  ...(role.faq.length ? [{ id: 'faq', label: t(lang, 'roles.faq') }] : []),
];
---
<Base lang={lang} title={`${role.title} - ${t(lang, 'site.short')}`} description={role.tagline}
      crumbs={[{ label: t(lang, 'nav.roles'), href: L('roles/') }, { label: role.title }]}>

  <!-- Шапка ролі -->
  <div class="relative overflow-hidden border-b border-(--color-line) bg-white">
    <img src={`${base}img/roles-blueprint.png`} alt="" width="1344" height="768"
         class="pointer-events-none absolute inset-y-0 right-0 hidden h-full w-auto object-contain object-right opacity-50 xl:block" />
    <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-white via-white/85 to-white/20 xl:block"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:px-8">
      <div class="flex items-start gap-5">
        <span class="block h-24 w-24 shrink-0 overflow-hidden rounded-full border border-(--color-line) bg-[radial-gradient(circle_at_50%_38%,#eef4f8_0%,var(--color-wash)_72%)]">
          <img src={`${base}img/role-${role.slug}.webp`} alt="" width="96" height="96" class="h-full w-full object-cover object-[center_10%]" />
        </span>
        <div class="min-w-0">
          <p class="text-[11.5px] font-bold uppercase tracking-widest text-(--color-mute)">{t(lang, `roles.groups.${role.group}`)}</p>
          <h1 class="mt-0.5 text-2xl font-extrabold leading-tight text-(--color-brand) md:text-3xl">{role.title}</h1>
          <p class="mt-2 max-w-xl text-[14.5px] leading-relaxed text-(--color-ink-2)">{role.tagline}</p>
          <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-[13px]">
            {bossRole && (
              <span class="flex items-center gap-1.5 text-(--color-ink-2)">
                <span class="font-bold text-(--color-mute)">{t(lang, 'role.manager')}:</span>
                <a href={L(`roles/${bossRole.slug}/`)} class="font-semibold text-(--color-accent) hover:text-(--color-accent-2)">{bossRole.cardName}</a>
              </span>
            )}
            {nearestTerms.length > 0 && (
              <span class="flex items-center gap-1.5 text-(--color-ink-2)">
                <span class="font-bold text-(--color-mute)">{t(lang, 'role.nearest')}:</span>
                <span class="font-medium">{nearestTerms.join(' · ')}</span>
              </span>
            )}
            {submitDocs.length > 0 && (
              <a href={dodatkyFolder} target="_blank" rel="noopener"
                 class="inline-flex min-h-[40px] items-center gap-2 rounded-[10px] border-[1.5px] border-(--color-line) bg-white px-4 text-[13px] font-bold text-(--color-brand) transition-colors hover:border-(--color-accent) hover:text-(--color-accent)">
                <Icon name="file-text" size={14} /> {t(lang, 'role.allForms')}
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Якірна навігація: чипи на десктопі, select на мобільному -->
  <nav class="no-print sticky top-14 z-30 border-b border-(--color-line) bg-white/90 backdrop-blur" aria-label={t(lang, 'misc.onThisPage')}>
    <div class="mx-auto max-w-6xl px-4 md:px-8">
      <div class="hidden gap-1 overflow-x-auto py-2 sm:flex">
        {anchors.map((a) => (
          <a href={`#${a.id}`} class="shrink-0 rounded-[10px] px-3.5 py-2 text-[13px] font-semibold text-(--color-ink-2) transition-colors hover:bg-(--color-wash) hover:text-(--color-brand)">{a.label}</a>
        ))}
      </div>
      <label class="block py-2 sm:hidden">
        <span class="sr-only">{t(lang, 'misc.onThisPage')}</span>
        <select id="role-anchor" class="w-full min-h-[44px] rounded-[10px] border border-(--color-line) bg-white px-3 text-[14px] font-semibold text-(--color-brand) focus:border-(--color-accent) focus:outline-none">
          {anchors.map((a) => <option value={a.id}>{a.label}</option>)}
        </select>
      </label>
    </div>
  </nav>

  <div class="mx-auto max-w-6xl px-4 py-8 md:px-8" data-pagefind-body>
    <!-- Ключові задачі + Основні документи -->
    <div class="grid grid-cols-1 gap-4 lg:grid-cols-5">
      <section id="tasks" class="scroll-mt-28 rounded-2xl border border-(--color-line) bg-white p-5 md:p-6 lg:col-span-3" data-reveal>
        <h2 class="flex items-center gap-2 text-[16px] font-extrabold text-(--color-brand)">
          <Icon name="check-square" size={17} class="text-(--color-accent)" /> {t(lang, 'roles.keyTasks')}
        </h2>
        <ul class="mt-4 space-y-2.5">
          {zone.map((item) => (
            <li class="flex gap-3 text-[14px] leading-relaxed">
              <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-(--color-ok-bg) text-(--color-ok)">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4 10-10"/></svg>
              </span>
              <span set:html={A(clean(item))} />
            </li>
          ))}
        </ul>
        {role.kpi && (
          <div class="mt-5 rounded-xl bg-(--color-wash) p-4">
            <p class="text-[10.5px] font-bold uppercase tracking-wider text-(--color-accent)">{t(lang, 'roles.kpi')}</p>
            <p class="mt-1 text-[13px] font-medium leading-relaxed" set:html={A(role.kpi)} />
          </div>
        )}
      </section>

      <section id="docs" class="scroll-mt-28 rounded-2xl border border-(--color-line) bg-white p-5 md:p-6 lg:col-span-2" data-reveal style="--reveal-delay:90ms">
        <h2 class="flex items-center gap-2 text-[16px] font-extrabold text-(--color-brand)">
          <Icon name="file-text" size={17} class="text-(--color-accent)" /> {t(lang, 'roles.mainDocs')}
        </h2>
        <div class="mt-4 space-y-1.5">
          {mainDocs.map((d) => (
            <a href={L(`docs/${d.slug}/`)} class="group flex items-center gap-2.5 rounded-lg px-2 py-1.5 transition-colors hover:bg-(--color-wash)">
              <DocChip index={d.index} size="sm" />
              <span class="min-w-0 flex-1 truncate text-[13px] font-medium text-(--color-ink) group-hover:text-(--color-accent)">{d.name}</span>
              <Icon name="arrow-right" size={13} class="shrink-0 text-(--color-mute) opacity-0 transition-opacity group-hover:opacity-100" />
            </a>
          ))}
          {mainDocs.length === 0 && <p class="text-[13px] text-(--color-mute)">{t(lang, 'roles.noDocs')}</p>}
        </div>
      </section>
    </div>

    <!-- Ланцюг взаємодії -->
    {role.chain.length > 0 && (
      <section id="chain" class="scroll-mt-28 mt-4 rounded-2xl border border-(--color-line) bg-white p-5 md:p-6" data-reveal>
        <h2 class="flex items-center gap-2 text-[16px] font-extrabold text-(--color-brand)">
          <Icon name="route" size={17} class="text-(--color-accent)" /> {t(lang, 'roles.chain')}
        </h2>
        <div class="mt-5 overflow-x-auto pb-1">
          <div class="flex items-stretch gap-0">
            {role.chain.map((c, i) => (
              <>
                {i > 0 && <span class="flex shrink-0 items-center px-1 text-(--color-line)"><Icon name="arrow-right" size={16} /></span>}
                {c.slug ? (
                  <a href={L(`roles/${c.slug}/`)} class="group w-36 shrink-0 rounded-xl border border-(--color-line) bg-(--color-paper) p-3.5 text-center transition-all hover:border-(--color-accent) hover:bg-white hover:shadow-sm">
                    <span class="mx-auto grid h-9 w-9 place-items-center rounded-lg bg-white text-(--color-accent) shadow-sm transition-colors group-hover:bg-(--color-accent) group-hover:text-white">
                      <Icon name={c.icon} size={17} />
                    </span>
                    <p class="mt-2 text-[12px] font-bold leading-tight text-(--color-brand)">{c.name}</p>
                    {c.why && <p class="mt-1 line-clamp-2 text-[10.5px] leading-snug text-(--color-mute)">{c.why}</p>}
                  </a>
                ) : (
                  <span class="w-36 shrink-0 rounded-xl border border-(--color-line) bg-(--color-paper) p-3.5 text-center">
                    <span class="mx-auto grid h-9 w-9 place-items-center rounded-lg bg-white text-(--color-accent) shadow-sm"><Icon name={c.icon} size={17} /></span>
                    <p class="mt-2 text-[12px] font-bold leading-tight text-(--color-brand)">{c.name}</p>
                    {c.why && <p class="mt-1 line-clamp-2 text-[10.5px] leading-snug text-(--color-mute)">{c.why}</p>}
                  </span>
                )}
              </>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Коли до вас звертаються -->
    {role.asked.length > 0 && (
      <section id="asked" class="scroll-mt-28 mt-4 rounded-2xl border border-(--color-line) bg-white p-5 md:p-6" data-reveal>
        <h2 class="flex items-center gap-2 text-[16px] font-extrabold text-(--color-brand)">
          <Icon name="megaphone" size={17} class="text-(--color-accent)" /> {t(lang, 'roles.asked')}
        </h2>
        <p class="mt-1 text-[12.5px] text-(--color-mute)">{t(lang, 'roles.askedHint')}</p>
        <div class="mt-4 divide-y divide-(--color-line)">
          {role.asked.map((rt) => (
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 py-3">
              <p class="min-w-0 flex-1 text-[13.5px] font-medium" set:html={A(rt.what)} />
              <p class="text-[12px] text-(--color-mute)">{rt.who}</p>
              <span class="chip shrink-0 rounded-full bg-(--color-wash) px-2.5 py-1 text-[11px] font-bold text-(--color-brand)">{rt.term}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Обовʼязки + Документи і строки -->
    <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2">
      {duties.length > 0 && (
        <section id="duties" class="scroll-mt-28 rounded-2xl border border-(--color-line) bg-white p-5 md:p-6">
          <h2 class="flex items-center gap-2 text-[16px] font-extrabold text-(--color-brand)">
            <Icon name="clipboard-list" size={17} class="text-(--color-accent)" /> {t(lang, 'roles.duties')}
          </h2>
          <ol class="mt-4 space-y-2.5">
            {duties.map((item, n) => (
              <li class="flex gap-3 text-[13.5px] leading-relaxed">
                <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-(--color-wash) text-[10.5px] font-bold text-(--color-brand)">{n + 1}</span>
                <span set:html={A(clean(item))} />
              </li>
            ))}
          </ol>
        </section>
      )}

      {(submitDocs.length > 0 || receiveDocs.length > 0) && (
        <section class="rounded-2xl border border-(--color-line) bg-white p-5 md:p-6">
          <h2 class="flex items-center gap-2 text-[16px] font-extrabold text-(--color-brand)">
            <Icon name="clock" size={17} class="text-(--color-accent)" /> {t(lang, 'roles.docsAndTerms')}
          </h2>
          {[[t(lang, 'roles.submits'), submitDocs], [t(lang, 'roles.receives'), receiveDocs]].map(([label, list]) => list.length > 0 && (
            <div class="mt-4">
              <p class="mb-2 text-[11px] font-bold uppercase tracking-wider text-(--color-mute)">{label}</p>
              <div class="space-y-1.5">
                {list.map((d) => (
                  <a href={L(`docs/${d.slug}/`)} class="group flex items-center gap-2.5 rounded-lg px-2 py-1.5 transition-colors hover:bg-(--color-wash)">
                    <DocChip index={d.index} size="sm" />
                    <span class="min-w-0 flex-1">
                      <span class="block truncate text-[13px] font-medium group-hover:text-(--color-accent)">{d.name}</span>
                      <span class="block text-[11px] text-(--color-mute)">{d.term}</span>
                    </span>
                  </a>
                ))}
              </div>
            </div>
          ))}
        </section>
      )}
    </div>

    <!-- FAQ -->
    {role.faq.length > 0 && (
      <section class="mt-4 rounded-2xl border border-(--color-line) bg-white p-5 md:p-6" data-reveal>
        <h2 class="flex items-center gap-2 text-[16px] font-extrabold text-(--color-brand)">
          <Icon name="question" size={17} class="text-(--color-accent)" /> {t(lang, 'roles.faq')}
        </h2>
        <div class="mt-3 divide-y divide-(--color-line)">
          {role.faq.map((f) => (
            <details class="group py-1">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 py-2.5 text-[14px] font-semibold text-(--color-ink) transition-colors hover:text-(--color-accent) [&::-webkit-details-marker]:hidden">
                {f.q}
                <svg class="shrink-0 text-(--color-mute) transition-transform duration-200 group-open:rotate-180" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <p class="pb-3 text-[13.5px] leading-relaxed text-(--color-ink-2)" set:html={A(f.a)} />
            </details>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>

<script>
  const sel = document.getElementById('role-anchor') as HTMLSelectElement | null;
  sel?.addEventListener('change', () => {
    document.getElementById(sel.value)?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
</script>
