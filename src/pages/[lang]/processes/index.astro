---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import DocChip from '../../../components/DocChip.astro';
import { LANGS, getData, t } from '../../../lib/data.js';

export function getStaticPaths() { return LANGS.map((lang) => ({ params: { lang } })); }
const { lang } = Astro.params;
const base = import.meta.env.BASE_URL;
const { processes } = getData(lang);
const L = (p) => `${base}${lang}/${p}`;
---
<Base lang={lang} title={`${t(lang, 'processes.title')} - ${t(lang, 'site.short')}`} crumbs={[{ label: t(lang, 'nav.processes') }]}>
  <div class="relative overflow-hidden border-b border-(--color-line) bg-white">
    <img src={`${base}img/process-blueprint.png`} alt="" width="1216" height="896"
         class="pointer-events-none absolute inset-y-0 right-4 hidden h-full w-auto object-contain object-right opacity-60 xl:block" />
    <div class="pointer-events-none absolute inset-0 hidden bg-gradient-to-r from-white via-white/85 to-white/30 xl:block"></div>
    <div class="relative mx-auto max-w-6xl px-4 py-10 md:px-8">
      <h1 class="text-2xl font-extrabold text-(--color-brand) md:text-3xl">{t(lang, 'processes.title')}</h1>
      <p class="mt-2 max-w-xl text-[14.5px] text-(--color-ink-2)">{t(lang, 'processes.subtitle')}</p>
    </div>
  </div>

  <div class="mx-auto max-w-6xl px-4 py-8 md:px-8">
    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
      {processes.map((p) => (
        <a href={L(`processes/${p.slug}/`)} class="group relative rounded-2xl border border-(--color-line) bg-white p-6 transition-all duration-200 hover:-translate-y-0.5 hover:border-(--color-accent) hover:shadow-lg hover:shadow-slate-200/60">
          <div class="flex items-center gap-4">
            <span class="grid h-12 w-12 shrink-0 place-items-center rounded-xl bg-(--color-wash) text-(--color-accent) transition-colors group-hover:bg-(--color-accent) group-hover:text-white">
              <Icon name={p.icon} size={22} />
            </span>
            <p class="text-[16px] font-extrabold leading-snug text-(--color-brand) group-hover:text-(--color-accent)">{p.title}</p>
          </div>
          <p class="mt-3 text-[13px] leading-relaxed text-(--color-ink-2)">{p.lead}</p>
          <div class="mt-4 flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-(--color-wash) px-2.5 py-1 text-[11px] font-bold text-(--color-brand)">{p.steps.length} {t(lang, 'processes.stepsWord')}</span>
            {p.docs.slice(0, 5).map((idx) => <DocChip index={idx} size="sm" />)}
          </div>
        </a>
      ))}
    </div>
  </div>
</Base>
