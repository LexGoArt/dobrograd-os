---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import DocChip from '../../../components/DocChip.astro';
import { autolink } from '../../../lib/autolink.js';
import { LANGS, getData, t } from '../../../lib/data.js';

export function getStaticPaths() {
  return LANGS.flatMap((lang) =>
    getData(lang).processes.map((proc) => ({ params: { lang, slug: proc.slug }, props: { proc } }))
  );
}
const { lang } = Astro.params;
const { proc } = Astro.props;
const base = import.meta.env.BASE_URL;
const { docs, dict } = getData(lang);
const L = (p) => `${base}${lang}/${p}`;
const opts = { base, lang, dict: dict.indexes, terms: dict.terms };
const A = (s) => autolink(s ?? '', opts);
const procDocs = proc.docs.map((idx) => docs.find((d) => d.index === idx)).filter(Boolean);
---
<Base lang={lang} title={`${proc.title} - ${t(lang, 'site.short')}`} description={proc.lead}
      crumbs={[{ label: t(lang, 'nav.processes'), href: L('processes/') }, { label: proc.title }]}>
  <div class="border-b border-(--color-line) bg-white">
    <div class="mx-auto max-w-6xl px-4 py-10 md:px-8">
      <div class="flex items-start gap-4">
        <span class="grid h-13 w-13 h-[52px] w-[52px] shrink-0 place-items-center rounded-2xl border border-(--color-line) bg-(--color-wash) text-(--color-accent)">
          <Icon name={proc.icon} size={24} />
        </span>
        <div>
          <h1 class="text-2xl font-extrabold leading-tight text-(--color-brand) md:text-[1.8rem]">{proc.title}</h1>
          <p class="mt-2 max-w-2xl text-[14.5px] leading-relaxed text-(--color-ink-2)">{proc.lead}</p>
          <p class="mt-3 inline-flex items-center gap-2 rounded-full bg-(--color-stop-bg) px-3.5 py-1.5 text-[12.5px] font-bold text-(--color-stop)">
            <Icon name="alert" size={13} /> {proc.warn}
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="mx-auto max-w-6xl gap-6 px-4 py-8 md:px-8 lg:flex">
    <!-- Кроки -->
    <section class="min-w-0 flex-1" data-pagefind-body>
      <h2 class="mb-5 text-[16px] font-extrabold text-(--color-brand)">{t(lang, 'processes.steps')}</h2>
      <ol class="relative space-y-4 before:absolute before:bottom-6 before:left-[19px] before:top-6 before:w-px before:bg-(--color-line)">
        {proc.steps.map((s, si) => (
          <li class="relative flex gap-4" data-reveal style={`--reveal-delay:${Math.min(si, 5) * 70}ms`}>
            <span class="z-10 grid h-10 w-10 shrink-0 place-items-center rounded-full bg-(--color-brand) text-[14px] font-extrabold text-white ring-4 ring-(--color-paper)">{s.num}</span>
            <div class="min-w-0 flex-1 rounded-2xl border border-(--color-line) bg-white p-4.5 p-5">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                <p class="text-[13px] font-bold text-(--color-accent)">{s.who}</p>
                {s.day && <span class="chip rounded-full bg-(--color-wash) px-2.5 py-0.5 text-[11px] font-bold text-(--color-brand)">{s.day}</span>}
              </div>
              <p class="mt-1.5 text-[14px] leading-relaxed" set:html={A(s.what)} />
              {s.ifnot && (
                <p class="mt-2.5 flex items-start gap-2 rounded-lg bg-(--color-stop-bg) px-3 py-2 text-[12.5px] font-medium text-(--color-stop)">
                  <Icon name="alert" size={13} class="mt-0.5 shrink-0" />
                  <span set:html={A(s.ifnot)} />
                </p>
              )}
            </div>
          </li>
        ))}
      </ol>

      {proc.rhythm && (
        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
          {[['daily', proc.rhythm.daily], ['weekly', proc.rhythm.weekly]].map(([key, items]) => (
            <div class="rounded-2xl border border-(--color-line) bg-white p-5">
              <h3 class="flex items-center gap-2 text-[14px] font-extrabold text-(--color-brand)">
                <Icon name="clock" size={15} class="text-(--color-accent)" /> {t(lang, `processes.${key}`)}
              </h3>
              <ul class="mt-3 space-y-2">
                {items.map((it) => (
                  <li class="flex gap-2.5 text-[13px] leading-relaxed">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-(--color-accent)"></span>
                    <span set:html={A(it)} />
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Сайдбар процесу -->
    <aside class="mt-8 shrink-0 space-y-4 lg:mt-0 lg:w-80">
      {proc.stops && (
        <div class="rounded-2xl border-l-4 border-(--color-stop) bg-white p-5 shadow-sm">
          <h3 class="text-[13px] font-extrabold uppercase tracking-wide text-(--color-stop)">{t(lang, 'processes.stops')}</h3>
          <ul class="mt-3 space-y-2">
            {proc.stops.map((s) => (
              <li class="flex gap-2.5 text-[12.5px] leading-snug">
                <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-(--color-stop)"></span>
                <span set:html={A(s)} />
              </li>
            ))}
          </ul>
        </div>
      )}
      <div class="rounded-2xl border border-(--color-line) bg-white p-5">
        <h3 class="flex items-center gap-2 text-[13px] font-extrabold uppercase tracking-wide text-(--color-warn)">
          <Icon name="alert" size={14} /> {t(lang, 'processes.errors')}
        </h3>
        <ul class="mt-3 space-y-2">
          {proc.errors.map((e) => (
            <li class="flex gap-2.5 text-[12.5px] leading-snug text-(--color-ink-2)">
              <span class="mt-1 h-1.5 w-1.5 shrink-0 rounded-full bg-(--color-warn)"></span>
              <span set:html={A(e)} />
            </li>
          ))}
        </ul>
      </div>
      <div class="rounded-2xl border border-(--color-line) bg-white p-5">
        <h3 class="text-[13px] font-extrabold uppercase tracking-wide text-(--color-brand)">{t(lang, 'processes.docs')}</h3>
        <div class="mt-3 space-y-1.5">
          {procDocs.map((d) => (
            <a href={L(`docs/${d.slug}/`)} class="group flex items-center gap-2.5 rounded-lg px-2 py-1.5 transition-colors hover:bg-(--color-wash)">
              <DocChip index={d.index} size="sm" />
              <span class="min-w-0 flex-1 truncate text-[12.5px] font-medium group-hover:text-(--color-accent)">{d.name}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</Base>
